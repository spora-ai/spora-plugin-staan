{
    "name": "spora-ai/spora-plugin-staan",
    "description": "EU-hosted web search via Staan — ranked results, or relevance-scored page excerpts for RAG.",
    "type": "spora-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "spora-ai/spora-core": ">=0.30.0 <2.0.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-mockery": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Spora\\Plugins\\Staan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spora\\Plugins\\Staan\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --no-progress",
        "lint": "php-cs-fixer fix --dry-run --diff --no-interaction",
        "format": "php-cs-fixer fix"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "spora-ai/installer": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../spora-core",
            "options": {
                "symlink": true,
                "versions": {
                    "spora-ai/spora-core": "0.30.0"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
